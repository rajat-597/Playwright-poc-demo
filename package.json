{
  "name": "playwright-js-poc",
  "version": "1.0.0",
  "description": "Playwright project with data-driven tests and Allure reporting",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright test --reporter=allure-playwright",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:serve": "allure serve allure-report"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "allure"
  ],
  "author": "Your Name",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.9.1",
    "allure-playwright": "^3.4.1"
  },
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
